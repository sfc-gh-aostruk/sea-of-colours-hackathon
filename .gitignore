# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# Generated tutorial films. The GENERATOR is the deliverable
# (scripts/_film_drop.py, later scripts/make_tutorial_films.py); the
# .webm/.mp4 and extracted frames are build output and are re-shot by
# re-running it. See docs/TUTORIAL_PLAN.md §4.1.
reports/films/

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Editor / OS
.DS_Store
.idea/
.vscode/

# Local agent/tooling settings
.claude/

# Secrets / local config (never commit)
*.env
.env*
connections.toml
secrets.toml
*.pem
*.key

# Local file-backed store output (SOC_BACKEND=file) + sweep artifacts.
# Generated CSVs are regenerable; the summary .md reports are docs (kept).
/seasons/
/seasons_battery/
/seasons_battery.bak_*/
/_watch_seasons/
/_perf_seasons/
/_tmp_seasons_dbg/
/reports/*.csv
/reports/*.log
/reports/baseline_*.md
# Screenshots shot by the scratch harnesses (scripts/_fx_*.py). Regenerable by
# re-running the harness, and several MB a session. The frozen/*.json fixtures
# under reports/ are deliberately tracked and unaffected by this.
/reports/**/*.png
